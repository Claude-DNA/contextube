# Neon connection string (pooled). Set this in Vercel → Project → Settings → Environment Variables.
DATABASE_URL=postgresql://user:password@host/contextube?sslmode=require

# Writers allowed to call POST /api/v1/publish, as name:secret pairs separated by commas.
# Generate each secret with: openssl rand -hex 24
PUBLISH_KEYS=andrei:replace-me,navigator:replace-me,studio:replace-me

# Public site origin, used in sitemap, llms.txt and absolute links.
SITE_URL=https://contextube.ai

# Read API requests allowed per IP per minute (per server instance).
RATE_LIMIT_PER_MINUTE=60
